# Puerto HTTP del backend.
PORT=4000

# Origen permitido para CORS.
CORS_ORIGIN=http://127.0.0.1:4173

# PostgreSQL. Crea primero la BD "globalizat" desde pgAdmin 4.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@127.0.0.1:5432/globalizat

# Archivo JSON legado opcional. Si existe y PostgreSQL está vacío, se migra una sola vez.
LEGACY_DATA_FILE=./data/store.json

# Carpeta de cargas del Backend.
UPLOADS_DIR=./uploads

# Horas de validez de la sesión.
SESSION_TTL_HOURS=12

# Cuenta administrativa de demostración.
SEED_ADMIN_EMAIL=admin@globalizat.demo
SEED_ADMIN_PASSWORD=Admin12345!
